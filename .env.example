# Copy this file to .env and fill values from LINE Developers.
PORT=8001
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:8001

# Optional: when saving locally, mirror records to the Render app.
# Leave blank to use the default Render URL while running on PORT=8001.
REMOTE_SYNC_BASE_URL=https://ota-habit-coach.onrender.com

# Optional: persistent backup storage for Render restarts/redeploys.
# Deploy scripts/google-sheets-persistent-store.gs as a Google Apps Script web app,
# then paste its web app URL here and in Render.
PERSISTENT_STORE_WEBHOOK_URL=

# Optional: keep these stable after deploying to Render.
STUDENT_LINK_CODE=OTA-1234
COACH_LINK_CODE=COACH-1234

# Optional: set these after you know each LINE userId.
# This helps LINE links continue even if Render Free loses local files.
STUDENT_LINE_USER_ID=
COACH_LINE_USER_ID=

# Optional: also email the same daily report to the coach.
# REPORT_EMAIL_TO can be a Gmail address such as the coach's address.
# The easiest setup is GOOGLE_SCRIPT_EMAIL_WEBHOOK_URL, which sends through Gmail with Google Apps Script.
REPORT_EMAIL_TO=coach@example.com
GOOGLE_SCRIPT_EMAIL_WEBHOOK_URL=

# Optional alternative: Resend. This requires a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: use a different local data folder.
DATA_DIR=data
