# Copy this file to .env and fill values from LINE Developers.
PORT=8001
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:8001

# Optional: keep these stable after deploying to Render.
STUDENT_LINK_CODE=OTA-1234
COACH_LINK_CODE=COACH-1234

# Optional: set this after you know the coach's LINE userId.
# This helps daily reports continue even if Render Free loses local files.
COACH_LINE_USER_ID=

# Optional: also email the same daily report to the coach.
# REPORT_EMAIL_TO can be a Gmail address such as the coach's address.
# The easiest setup is GOOGLE_SCRIPT_EMAIL_WEBHOOK_URL, which sends through Gmail with Google Apps Script.
REPORT_EMAIL_TO=coach@example.com
GOOGLE_SCRIPT_EMAIL_WEBHOOK_URL=

# Optional alternative: Resend. This requires a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: use a different local data folder.
DATA_DIR=data
